# Supabase — côté client (exposées au navigateur, OK pour anon key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — côté serveur UNIQUEMENT (ne jamais exposer au navigateur)
# Utilisée pour les opérations admin (migrations, scripts). Ne pas committer.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Nom public uniquement, sans @ ni jeton secret (pour les liens d'invitation).
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Les secrets TELEGRAM_BOT_TOKEN / TELEGRAM_WEBHOOK_SECRET / TELEGRAM_PILOT_ENABLED
# se configurent dans Supabase Edge Functions, pas dans des variables NEXT_PUBLIC.

# Notifications mobiles — serveur Next/Vercel seulement (valeurs secrètes hors Git).
# TELEGRAM_BOT_TOKEN doit aussi être configuré sur ce serveur pour son expéditeur.
APP_PUBLIC_URL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=
TELEGRAM_BOT_TOKEN=
